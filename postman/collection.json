          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/products?minPrice=100&maxPrice=1500&inStock=true&search=Laptop",
              "host": ["{{baseUrl}}"],
              "path": ["api", "products"],
              "query": [
                { "key": "minPrice", "value": "100" },
                { "key": "maxPrice", "value": "1500" },
                { "key": "inStock", "value": "true" },
                { "key": "search", "value": "Laptop" }
              ]
            }
          }
        },
